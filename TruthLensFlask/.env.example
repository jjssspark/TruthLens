# ==== 필수: 로컬 개발용 최소 설정 ====
# 아래 두 줄만 채우면 SQLite로 앱이 바로 뜹니다 (MariaDB/Redis 설치 불필요)
# 주의: SQLite는 로컬 전용입니다. 배포에 쓰면 컨테이너 디스크가 초기화될 때
# 가입한 계정이 통째로 사라집니다 (TROUBLESHOOTING 17번).
# 배포에서는 외부 관리형 DB를 씁니다 — postgresql://user:pw@host:5432/dbname
SECRET_KEY=dev-secret-key-change-me
DATABASE_URL=sqlite:///dev.db

# ==== AI 판별 기능별 API 키 (없으면 해당 기능만 에러 응답, 앱 자체는 정상 구동) ====
# 뉴스 판별(FR-03)과 논문 판별(FR-04)에 필요 — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 뉴스 판별 모델. 기본 gemini-2.5-flash-lite(약 1.5초).
# gemini-2.5-flash는 내부 추론을 수행해 약 16초가 걸리는 대신 더 정밀하다.
GEMINI_MODEL=
GEMINI_TIMEOUT_SEC=30

# 논문에서 분석할 최대 글자 수. 기본 50000자.
# 넘는 분량은 판정에 반영되지 않으며 그 사실이 결과에 표시된다.
PAPER_MAX_CHARS=

# 논문 판별은 OpenAI 호환 엔드포인트로 호출한다. 기본은 Gemini이며
# GEMINI_API_KEY를 그대로 쓴다. 셋 다 비워두면 기본값으로 동작한다.
# 다른 제공자(DeepSeek 등)로 바꾸려면 셋을 함께 지정한다.
#   PAPER_API_KEY=sk-xxxx
#   PAPER_API_BASE_URL=https://api.deepseek.com/v1
#   PAPER_MODEL=deepseek-chat
PAPER_API_KEY=
PAPER_API_BASE_URL=
PAPER_MODEL=

# ==== 영상 딥페이크 판별(FR-01) · 이미지 AI 생성 판별(FR-02) — 선택 ====
# 없으면 로컬 픽셀 휴리스틱으로 동작하며, 결과의 details.method에 어떤 방식을
# 썼는지 표시된다. https://huggingface.co/settings/tokens 에서 read 토큰 발급
HF_TOKEN=
# 영상용. 기본값: prithivMLmods/deepfake-detector-model-v1 (Siglip, Fake/Real 2클래스)
HF_DEEPFAKE_MODEL=
# 이미지용. 기본값: haywoodsloan/ai-image-detector-deploy (artificial/real 2클래스)
# 영상용 딥페이크 모델은 '얼굴 조작' 탐지라 정지 이미지의 AI 생성 판별에는 쓰지 않는다.
HF_IMAGE_MODEL=

# ==== 운영(MariaDB) 배포 시 사용 — DATABASE_URL을 비우면 아래 값으로 접속 ====
DB_HOST=localhost
DB_NAME=truthlens
DB_USER=root
DB_PASSWORD=
DB_PORT=3306

# ==== Redis (없으면 캐싱만 비활성화되고 기능은 정상 동작) ====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ==== 기타 ====
FLASK_ENV=development
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=524288000
