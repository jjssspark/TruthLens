# ==== 필수: 로컬 개발용 최소 설정 ====
# 아래 두 줄만 채우면 SQLite로 앱이 바로 뜹니다 (MariaDB/Redis 설치 불필요)
SECRET_KEY=dev-secret-key-change-me
DATABASE_URL=sqlite:///dev.db

# ==== AI 판별 기능별 API 키 (없으면 해당 기능만 에러 응답, 앱 자체는 정상 구동) ====
# 뉴스 판별(FR-03)에 필요 — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 논문 판별(FR-04)에 필요 — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ==== Google OAuth 로그인 (없으면 이메일/비밀번호 로그인만 사용 가능) ====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==== 운영(MariaDB) 배포 시 사용 — DATABASE_URL을 비우면 아래 값으로 접속 ====
DB_HOST=localhost
DB_NAME=truthlens
DB_USER=root
DB_PASSWORD=
DB_PORT=3306

# ==== Redis (없으면 캐싱만 비활성화되고 기능은 정상 동작) ====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ==== 기타 ====
FLASK_ENV=development
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=524288000
