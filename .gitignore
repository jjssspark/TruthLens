# Python
__pycache__/
*.pyc
*.egg-info/
venv/
.venv/

# 테스트 · 커버리지
.pytest_cache/
.coverage
coverage/

# 환경변수 · 비밀값 (.env.example만 추적)
.env*
!.env.example

# 로컬 DB · 로그
*.db
*.log
instance/

# 업로드 파일은 분석 후 삭제 대상이므로 추적하지 않음 (4.2 보안)
# 슬래시가 중간에 있는 패턴은 .gitignore 위치(저장소 루트) 기준으로만
# 매칭된다. 실제 업로드 폴더는 TruthLensFlask/uploads/라 **가 필요하다.
**/uploads/*
!**/uploads/.gitkeep

# 원본 데모 영상 (용량이 커서 GitHub에 올리지 않음 — Notion/개인 웹사이트에만 사용, README용 GIF만 커밋)
docs/assets/video/

# 에디터 · OS
.DS_Store
.vscode/

# Claude Code (로컬 전용 — 커밋하지 않음)
CLAUDE.md
.claude/
.understand-anything

# Tailwind 빌드 도구 (빌드 산출물 static/css/tailwind.*.css는 커밋한다 — 배포 이미지에 node가 없다)
node_modules/

# 측정용 영상 데이터셋 (deepaction_v1 부분집합) — 용량이 커서 추적하지 않는다
datasets/

# macOS 잡파일
.DS_Store

# 슬라이드 PDF (HTML 원본만 추적 — PDF는 8.9MB라 이력이 커진다)
docs/slides/*.pdf
